<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DouyinTTS.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="2" MaxWidth="800">
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="设置"
                Margin="0,0,0,24" />

            <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="语音设置"
                Margin="0,0,0,12" />

            <toolkit:SettingsCard
                Header="语音选择"
                Description="选择 TTS 播报使用的语音">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE767;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="VoiceComboBox"
                    MinWidth="200"
                    HorizontalAlignment="Right" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                Header="音量"
                Description="调整语音播报音量">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE767;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Slider
                    x:Name="VolumeSlider"
                    Minimum="0"
                    Maximum="200"
                    Value="100"
                    StepFrequency="10"
                    Width="200"
                    HorizontalAlignment="Right" />
            </toolkit:SettingsCard>

            <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="播报设置"
                Margin="0,24,0,12" />

            <toolkit:SettingsExpander
                Header="消息类型"
                Description="选择需要语音播报的消息类型">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8BD;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard ContentAlignment="Left">
                        <ToggleSwitch
                            x:Name="DanmakuToggle"
                            Header="弹幕消息"
                            IsOn="True"
                            OnContent="播报" OffContent="不播报" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard ContentAlignment="Left">
                        <ToggleSwitch
                            x:Name="GiftToggle"
                            Header="礼物打赏"
                            IsOn="True"
                            OnContent="播报" OffContent="不播报" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard ContentAlignment="Left">
                        <ToggleSwitch
                            x:Name="MemberToggle"
                            Header="用户进场"
                            IsOn="False"
                            OnContent="播报" OffContent="不播报" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard ContentAlignment="Left">
                        <ToggleSwitch
                            x:Name="LikeToggle"
                            Header="点赞"
                            IsOn="False"
                            OnContent="播报" OffContent="不播报" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="过滤设置"
                Margin="0,24,0,12" />

            <toolkit:SettingsCard
                Header="关键词过滤"
                Description="包含以下关键词的消息不播报，用逗号分隔">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE71E;" />
                </toolkit:SettingsCard.HeaderIcon>
                <TextBox
                    x:Name="FilterKeywordsBox"
                    PlaceholderText="关键词1, 关键词2, ..."
                    MinWidth="200"
                    HorizontalAlignment="Right" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                Header="去重窗口"
                Description="相同消息在指定秒数内不重复播报">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE71C;" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumberBox
                        x:Name="DedupeWindowBox"
                        Minimum="0"
                        Maximum="60"
                        Value="3"
                        SpinButtonPlacementMode="Inline"
                        Width="100" />
                    <TextBlock Text="秒" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                </StackPanel>
            </toolkit:SettingsCard>

            <Button
                Style="{StaticResource AccentButtonStyle}"
                Content="保存设置"
                Click="SaveButton_Click"
                HorizontalAlignment="Right"
                Margin="0,24,0,0" />

            <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="关于"
                Margin="0,48,0,12" />

            <toolkit:SettingsCard
                Header="DouyinTTS"
                Description="抖音直播间弹幕播报软件 v1.0.0">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" />
                </toolkit:SettingsCard.HeaderIcon>
                <TextBlock
                    Text="WinUI 3 + Fluent Design"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
            </toolkit:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
