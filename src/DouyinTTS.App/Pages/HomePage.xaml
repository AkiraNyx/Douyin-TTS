<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DouyinTTS.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DouyinTTS.App.ViewModels"
    mc:Ignorable="d"
    Unloaded="Page_Unloaded">

    <Grid Padding="24" RowSpacing="16" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="抖音弹幕播报" />

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="RoomInputBox"
                Grid.Column="0"
                PlaceholderText="输入直播间号或分享链接..." />

            <Button
                x:Name="ConnectButton"
                Grid.Column="1"
                Style="{StaticResource AccentButtonStyle}"
                Click="ConnectButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8F7;" FontSize="16" />
                    <TextBlock Text="连接" />
                </StackPanel>
            </Button>

            <Button
                x:Name="DisconnectButton"
                Grid.Column="2"
                Click="DisconnectButton_Click"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71A;" FontSize="16" />
                    <TextBlock Text="断开" />
                </StackPanel>
            </Button>

            <Button
                x:Name="CancelButton"
                Grid.Column="2"
                Click="CancelButton_Click"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71A;" FontSize="16" />
                    <TextBlock Text="取消" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="24">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse
                    x:Name="StatusIndicator"
                    Width="10" Height="10"
                    Fill="Gray" />
                <TextBlock
                    x:Name="StatusText"
                    Text="未连接"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
                <Button
                    x:Name="CopyStatusButton"
                    Padding="4,2"
                    MinHeight="0"
                    MinWidth="0"
                    Visibility="Collapsed"
                    Click="CopyStatusButton_Click"
                    ToolTipService.ToolTip="复制">
                    <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                </Button>
            </StackPanel>

            <TextBlock
                x:Name="RoomTitleText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="Collapsed" />

            <StackPanel
                x:Name="ViewerPanel"
                Orientation="Horizontal" Spacing="4"
                Visibility="Collapsed">
                <FontIcon Glyph="&#xE8B5;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="ViewerCountText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Button
                x:Name="ShowWebViewButton"
                Padding="4,2" MinHeight="0" MinWidth="0"
                Click="ShowWebViewButton_Click"
                Visibility="Collapsed"
                ToolTipService.ToolTip="显示 WebView">
                <FontIcon Glyph="&#xE7C3;" FontSize="12" />
            </Button>
        </StackPanel>

        <Grid Grid.Row="3">
            <!-- WebView2 登录/验证码层 -->
            <Grid x:Name="WebViewOverlay" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <InfoBar x:Name="WebViewInfoBar" Grid.Row="0"
                         IsOpen="True"
                         IsIconVisible="True"
                         IsClosable="False"
                         Title="提示"
                         Message="请在下方完成登录或验证码验证，完成后点击「隐藏窗口」按钮继续"
                         Severity="Informational" />
                <WebView2 x:Name="WebView" Grid.Row="1" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Padding="12,8"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Button x:Name="HideWebViewButton" Style="{StaticResource AccentButtonStyle}"
                            Click="HideWebViewButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE73A;" FontSize="14" />
                            <TextBlock Text="隐藏窗口" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RefreshWebViewButton"
                            Click="RefreshWebViewButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="刷新页面" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 消息列表层 -->
            <Border x:Name="MessagePanel"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="8" Padding="6,4" Orientation="Horizontal">
                    <AutoSuggestBox
                        x:Name="FilterBox"
                        PlaceholderText="过滤消息..."
                        Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        QueryIcon="Find"
                        MinWidth="200" />
                    <Button Click="FilterPreset_Click" Tag="Gift" Padding="8,2" MinHeight="0">
                        <TextBlock Text="🎁 礼物" FontSize="12" />
                    </Button>
                    <Button Click="FilterPreset_Click" Tag="LightGift" Padding="8,2" MinHeight="0">
                        <TextBlock Text="💡 轻礼物" FontSize="12" />
                    </Button>
                    <Button Click="FilterPreset_Click" Tag="Chat" Padding="8,2" MinHeight="0">
                        <TextBlock Text="💬 弹幕" FontSize="12" />
                    </Button>
                    <Button Click="FilterPreset_Click" Tag="Member" Padding="8,2" MinHeight="0">
                        <TextBlock Text="👋 进场" FontSize="12" />
                    </Button>
                    <Button Click="FilterPreset_Click" Tag="ERR" Padding="8,2" MinHeight="0">
                        <TextBlock Text="🐛 调试" FontSize="12" />
                    </Button>
                    <Button Click="FilterClear_Click" Padding="8,2" MinHeight="0">
                        <TextBlock Text="✕ 清除" FontSize="12" />
                    </Button>
                </StackPanel>

                <ListView
                    x:Name="MessageList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.FilteredMessages, Mode=OneWay}"
                    SelectionMode="None"
                    Background="Transparent">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:LiveEventItem">
                        <Grid Padding="0,6" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="{x:Bind Timestamp}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                FontSize="12"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind TypeIcon}"
                                FontFamily="Segoe MDL2 Assets"
                                Foreground="{x:Bind TypeBrush}"
                                FontSize="14"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis">
                                <Run FontWeight="SemiBold" Text="{x:Bind UserName}" />
                                <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Content}" />
                            </TextBlock>

                            <Button
                                Grid.Column="3"
                                Padding="4,2" MinHeight="0" MinWidth="0"
                                Click="CopyMessage_Click"
                                ToolTipService.ToolTip="复制"
                                VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8BD;" FontSize="14" Foreground="#FF2196F3" VerticalAlignment="Center" />
                <TextBlock x:Name="DanmakuCountText" Text="弹幕: 0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE719;" FontSize="14" Foreground="#FFFF9800" VerticalAlignment="Center" />
                <TextBlock x:Name="GiftCountText" Text="礼物: 0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="#FF4CAF50" VerticalAlignment="Center" />
                <TextBlock x:Name="MemberCountText" Text="进场: 0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <FontIcon Glyph="&#xE767;" FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Slider
                    x:Name="VolumeSlider"
                    Minimum="0" Maximum="100"
                    Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"
                    StepFrequency="5"
                    Width="120"
                    MinHeight="0"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="VolumeText"
                    Text="{x:Bind ViewModel.Volume, Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"
                    MinWidth="30" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
